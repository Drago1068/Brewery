# BrewingOS Environment Configuration
# Copy to .env (or /volume1/Apps/secrets/brewingos/.env on NAS).
# Never commit real credentials.
# Never point runtime paths at \\NazarioNAS\CODEX or other app shares.

COMPOSE_PROJECT_NAME=brewingos
BREWINGOS_ENV=development
BREWINGOS_SECRET_KEY=change-me-in-production
LOG_LEVEL=INFO

# PostgreSQL (internal to brewingos-data network only)
POSTGRES_USER=brewingos
POSTGRES_PASSWORD=brewingos
POSTGRES_DB=brewingos
DATABASE_URL=postgresql+asyncpg://brewingos:brewingos@postgres:5432/brewingos

# Runtime persistent storage — live NAS layout (ADR-002).
# Preferred /volume1/Apps/... remains aspirational when admin can create it.
# Windows Docker Desktop verification may override to a local-disk path.
BREWINGOS_POSTGRES_DATA=/volume1/docker/brewingos/data/postgres
BREWINGOS_STORAGE=/volume1/docker/brewingos/data/storage
BREWINGOS_BACKUPS=/volume1/docker/brewingos/backups
BREWINGOS_LOGS=/volume1/docker/brewingos/logs

# Reserved BrewingOS ports (outside AEGIS 8000/3000 and investing 18081-18084).
# Bind to loopback by default; expose privately via Tailscale Serve.
BACKEND_BIND=127.0.0.1
FRONTEND_BIND=127.0.0.1
BACKEND_PORT=18182
FRONTEND_PORT=18181
VITE_API_URL=http://127.0.0.1:18182
CORS_ORIGINS=http://127.0.0.1:18181,http://localhost:18181
