# BrewingOS Environment Configuration
# Copy to .env and adjust for local or NAS deployment.
# Never commit real credentials.

BREWINGOS_ENV=development
BREWINGOS_SECRET_KEY=change-me-in-production
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_USER=brewingos
POSTGRES_PASSWORD=brewingos
POSTGRES_DB=brewingos
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://brewingos:brewingos@postgres:5432/brewingos

# NAS / persistent storage (host paths). Override on UGREEN NAS.
# Defaults map to ./data/* for local Docker Compose.
BREWINGOS_POSTGRES_DATA=./data/postgres
BREWINGOS_STORAGE=./data/storage
BREWINGOS_BACKUPS=./data/backups
BREWINGOS_LOGS=./data/logs

# Frontend / API
VITE_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_PORT=8000
FRONTEND_PORT=5173
